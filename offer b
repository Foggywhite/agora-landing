    <!-- << EDIT >> supporting line -->
    <p class="lede">While maintaining high profit margins and zero burnout.</p>

    <figure class="video">
      <div class="frame" style="background-image:url('https://cdn.loom.com/sessions/thumbnails/066d807b10d2418aa4ed7888d8939020-cfc683d2c341f218-full-play.gif#t=0.1')">
        <iframe src="https://www.loom.com/embed/066d807b10d2418aa4ed7888d8939020?hideEmbedTopBar=true"
                title="Watch this" frameborder="0"
